{
  "id": "/",
  "name": "Pra Onde Foi",
  "short_name": "Pra Onde Foi",
  "description": "Descubra para onde vai o dinheiro da família: pix, cartão e renda num lugar só.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4EEE3",
  "theme_color": "#0B3C5D",
  "categories": [
    "finance",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/inicio.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Quanto sobrou no mês, avisos e o que fazer"
    },
    {
      "src": "/screenshots/lancar.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Lance por voz, foto da nota ou PDF da fatura"
    },
    {
      "src": "/screenshots/graficos.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Gráficos do seu jeito"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://praondefoi.app.br/manifest.webmanifest"
    }
  ],
  "shortcuts": [
    {
      "name": "Lançar falando",
      "short_name": "Falar",
      "description": "Abre direto o microfone para lançar um gasto",
      "url": "/?acao=voz",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Foto da nota",
      "short_name": "Nota",
      "description": "Tirar foto de uma nota fiscal",
      "url": "/?acao=nota",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Enviar fatura ou extrato",
      "short_name": "PDF",
      "description": "Enviar o PDF do banco",
      "url": "/?acao=pdf",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            "application/octet-stream",
            "*/*"
          ]
        }
      ]
    }
  }
}
