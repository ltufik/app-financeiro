{
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://images.pexels.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com https://images.pexels.com; worker-src 'self' blob: https://cdnjs.cloudflare.com; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/push-cron",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/push-cron?tipo=lembrete",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/push-cron?tipo=domingo&h=8",
      "schedule": "0 11 * * 0"
    },
    {
      "path": "/api/push-cron?tipo=domingo&h=9",
      "schedule": "0 12 * * 0"
    },
    {
      "path": "/api/push-cron?tipo=domingo&h=10",
      "schedule": "0 13 * * 0"
    },
    {
      "path": "/api/push-cron?tipo=domingo&h=11",
      "schedule": "0 14 * * 0"
    },
    {
      "path": "/api/push-cron?tipo=domingo&h=12",
      "schedule": "0 15 * * 0"
    },
    {
      "path": "/api/push-cron?tipo=domingo&h=13",
      "schedule": "0 16 * * 0"
    },
    {
      "path": "/api/push-cron?tipo=domingo&h=14",
      "schedule": "0 17 * * 0"
    },
    {
      "path": "/api/push-cron?tipo=domingo&h=15",
      "schedule": "0 18 * * 0"
    },
    {
      "path": "/api/push-cron?tipo=domingo&h=16",
      "schedule": "0 19 * * 0"
    },
    {
      "path": "/api/push-cron?tipo=domingo&h=17",
      "schedule": "0 20 * * 0"
    },
    {
      "path": "/api/push-cron?tipo=domingo&h=18",
      "schedule": "0 21 * * 0"
    },
    {
      "path": "/api/push-cron?tipo=domingo&h=19",
      "schedule": "0 22 * * 0"
    },
    {
      "path": "/api/push-cron?tipo=domingo&h=20",
      "schedule": "0 23 * * 0"
    },
    {
      "path": "/api/push-cron?tipo=domingo&h=21",
      "schedule": "0 0 * * 1"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "app-praondefoi.vercel.app"
        }
      ],
      "destination": "https://praondefoi.app.br/:path",
      "permanent": false
    }
  ]
}
